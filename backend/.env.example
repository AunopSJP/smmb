NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://smmb:smmb@localhost:5432/smmb
REDIS_URL=redis://localhost:6379
# ห้ามฮาร์ดโค้ดโดเมน — ทุกลิงก์ที่ server สร้าง (QR หน้าตู้, ลิงก์ในแจ้งเตือน) มาจากค่านี้
PUBLIC_BASE_URL=http://localhost:4200
# โดเมนที่ยอมรับใน qr_text (คั่นด้วย ,)
QR_ALLOWED_HOSTS=localhost
# ตอนขึ้นจริงหลัง reverse proxy ตั้งเป็น 1 · ว่าง = ไม่เชื่อ proxy
TRUST_PROXY=
VAPID_SUBJECT=mailto:admin@example.com
# สร้างด้วย: npx web-push generate-vapid-keys · แยกต่อ environment
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
