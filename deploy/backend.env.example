# /opt/smmb/backend/.env บนเครื่อง server จริง — ห้าม commit · chmod 600 · เจ้าของ = user smmb
NODE_ENV=production
PORT=3000
# ใช้รหัสเดียวกับ deploy/.env (POSTGRES_PASSWORD / REDIS_PASSWORD) · อักขระพิเศษในรหัสต้อง URL-encode (แนะนำใช้ openssl rand -hex)
DATABASE_URL=postgres://smmb:<POSTGRES_PASSWORD>@127.0.0.1:5432/smmb
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379
DB_POOL_MAX=10

# ทุกลิงก์ที่ server สร้าง (QR หน้าตู้ ลิงก์แจ้งเตือน) มาจากค่านี้ — ใส่ path ของเว็บด้วยถ้าเว็บอยู่ใต้ /smmb/
PUBLIC_BASE_URL=https://<โดเมนจริง>/smmb
QR_ALLOWED_HOSTS=<โดเมนจริง>
# Cloudflare → nginx → node = 2 · nginx → node = 1 (ผิด = ทุกคนใช้ IP เดียว rate limit รวมกันทั้งระบบ — ตรวจตาม docs/DEPLOY_UBUNTU.md ข้อ 9)
TRUST_PROXY=2
# prefix ที่ nginx ส่งมาแบบไม่ตัด (ตู้เซ็นลายเซ็นจาก path เต็ม) — ใช้ /smmb-api ให้ตรงกับ URL ที่เขียนลงบอร์ด
API_PATH_PREFIX=/smmb-api

# สร้างด้วย: openssl rand -hex 32 (คนละค่ากัน) · สำรองไว้ที่ปลอดภัย — BOX_MASTER_KEY หาย/เปลี่ยน = ทุกตู้ต้องเขียนรหัสลับใหม่, QR_SIGNING_KEY เปลี่ยน = QR ที่พิมพ์แล้วใช้ไม่ได้ทั้งหมด
BOX_MASTER_KEY=
QR_SIGNING_KEY=

# สร้างด้วย: cd backend && npx web-push generate-vapid-keys · เปลี่ยนค่า = ทุกเครื่องที่เปิดแจ้งเตือนไว้ต้องเปิดใหม่
VAPID_SUBJECT=mailto:<อีเมลผู้ดูแล>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
